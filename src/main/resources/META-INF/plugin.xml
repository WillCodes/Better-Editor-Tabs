<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>dev.willcodes.bettereditortabs</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Better Editor Tabs</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor>WillCodes</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Better Editor Tabs improves the editor tab bar in JetBrains IDEs.<br>
        <br>
        The first feature is Chrome/Edge-style manual tab groups:
        <ul>
            <li>Coloured, named groups of editor tabs</li>
            <li>Collapse and expand groups to keep the tab bar tidy</li>
            <li>Drag groups and tabs between editor splits</li>
            <li>Stash groups and restore them later</li>
            <li>Fill groups automatically with rules (module, directory or regex)</li>
        </ul>
        Requires the New UI and IDE version 2026.2 or later.
        ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <!-- Close Unmodified Tabs is registered by the VCS module, so its override only loads where that module exists. -->
    <depends optional="true" config-file="bettereditortabs-vcs.xml">com.intellij.modules.vcs</depends>

    <!-- User-visible strings live in src/main/resources/messages/BetterEditorTabsBundle.properties -->
    <resource-bundle>messages.BetterEditorTabsBundle</resource-bundle>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- If the plugin is published on JetBrains Marketplace, errors reported by users are available on the plugin page.
             See https://plugins.jetbrains.com/docs/marketplace/error-handler.html#developers-side for details. -->
        <errorHandler implementation="com.intellij.diagnostic.JetBrainsMarketplaceErrorReportSubmitter"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="dev.willcodes.bettereditortabs.tabgroups.tabbar.TabBarStartupActivity"/>
        <postStartupActivity implementation="dev.willcodes.bettereditortabs.tabgroups.tabbar.splits.SplitRestoreWatcher"/>
        <!-- IDE-3: grouped tabs are exempt from the editor tab limit. -->
        <editorAutoClosingHandler implementation="dev.willcodes.bettereditortabs.tabgroups.tabbar.ide.TabLimitHandler"/>
        <!-- The group popup and the delete confirmation; the service only knows the interface. -->
        <!-- POP-4: the Project view marks the files the edited auto-group rule matches. -->
        <projectViewNodeDecorator implementation="dev.willcodes.bettereditortabs.tabgroups.ui.projectview.RulePreviewDecorator"/>
        <projectService serviceInterface="dev.willcodes.bettereditortabs.tabgroups.service.TabGroupsUi"
                        serviceImplementation="dev.willcodes.bettereditortabs.tabgroups.ui.TabGroupsUiImpl"/>
        <!-- §14: Settings > Editor > General > Editor Tabs - Groups, right below Editor Tabs (children are listed by name). A project configurable because it lists the project's
             stash (SET-9); the values are application-level. parentId is Editor > General (EditorOptionsPanel): Editor Tabs is only an
             editorOptionsProvider child of that page, not a node of the settings tree, so it cannot be a parent (see TabGroupsConfigurable). -->
        <projectConfigurable parentId="preferences.editor" id="dev.willcodes.bettereditortabs.tabgroups"
                             instance="dev.willcodes.bettereditortabs.tabgroups.settings.TabGroupsConfigurable"
                             bundle="messages.BetterEditorTabsBundle" key="settings.display.name" nonDefaultProject="true"/>
    </extensions>

    <projectListeners>
        <listener class="dev.willcodes.bettereditortabs.tabgroups.tabbar.TabBarEditorListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
        <!-- PERS-3: restore the groups once the restored editor layout has settled. -->
        <listener class="dev.willcodes.bettereditortabs.tabgroups.service.TabGroupsRestoreListener"
                  topic="dev.willcodes.bettereditortabs.tabgroups.tabbar.splits.SplitsRestoredListener"/>
    </projectListeners>

    <applicationListeners>
        <!-- PERS-1: freeze the stored groups before the project closes (closing closes every tab). -->
        <listener class="dev.willcodes.bettereditortabs.tabgroups.service.TabGroupsCloseListener"
                  topic="com.intellij.openapi.project.ProjectCloseListener"/>
        <!-- MEM-4: renamed and moved files keep their group; stored URLs follow. -->
        <listener class="dev.willcodes.bettereditortabs.tabgroups.service.TabGroupsVfsListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
        <!-- §14: settings take effect without a restart; the cached strip look is re-applied in every open project. -->
        <listener class="dev.willcodes.bettereditortabs.tabgroups.service.TabGroupsSettingsApplier"
                  topic="dev.willcodes.bettereditortabs.tabgroups.service.TabGroupsSettingsListener"/>
    </applicationListeners>

    <actions>
        <!-- Overrides of built-in actions (LIFE-5, IDE-4). Keep these ids exactly. -->
        <action id="ReopenClosedTab" overrides="true"
                class="dev.willcodes.bettereditortabs.tabgroups.tabbar.ide.ReopenClosedTabAction"/>
        <action id="CloseAllEditorsButActive" overrides="true"
                class="dev.willcodes.bettereditortabs.tabgroups.tabbar.ide.CloseOthersAction"/>
        <action id="CloseAllEditors" overrides="true"
                class="dev.willcodes.bettereditortabs.tabgroups.tabbar.ide.CloseAllAction"/>
        <action id="CloseAllToTheLeft" overrides="true"
                class="dev.willcodes.bettereditortabs.tabgroups.tabbar.ide.CloseLeftAction"/>
        <action id="CloseAllToTheRight" overrides="true"
                class="dev.willcodes.bettereditortabs.tabgroups.tabbar.ide.CloseRightAction"/>
        <action id="CloseAllUnpinnedEditors" overrides="true"
                class="dev.willcodes.bettereditortabs.tabgroups.tabbar.ide.CloseUnpinnedAction"/>
        <!-- COLL-6: the "more" button's list of hidden tabs shows grouped and collapsed tabs under group headings. -->
        <action id="TabList" overrides="true"
                class="dev.willcodes.bettereditortabs.tabgroups.tabbar.ide.TabListOverride"/>

        <!-- LIFE-4: reachable through Find Action; Stage 12 adds it to Window > Editor Tabs > Tab Groups. No default shortcut. -->
        <action id="BetterEditorTabs.RestoreTabGroup"
                class="dev.willcodes.bettereditortabs.tabgroups.actions.RestoreTabGroupAction"/>

        <!-- CTX-5: New Tab Group (the tab strip's context menu has its own entry). No default shortcut. -->
        <action id="BetterEditorTabs.NewEmptyGroup"
                class="dev.willcodes.bettereditortabs.tabgroups.actions.NewEmptyGroupAction"/>

        <!-- CTX-1..CTX-4: tab context menu, one block after the pin / keep-open actions. No default shortcuts. -->
        <group id="BetterEditorTabs.TabMenu">
            <separator/>
            <action id="BetterEditorTabs.AddTabToNewGroup"
                    class="dev.willcodes.bettereditortabs.tabgroups.actions.AddTabToNewGroupAction"/>
            <group id="BetterEditorTabs.AddTabToGroup" popup="true"
                   class="dev.willcodes.bettereditortabs.tabgroups.actions.AddTabToGroupActionGroup"/>
            <action id="BetterEditorTabs.RemoveTabFromGroup"
                    class="dev.willcodes.bettereditortabs.tabgroups.actions.RemoveTabFromGroupAction"/>
            <separator/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="after" relative-to-action="KeepTabOpen"/>
        </group>

        <!-- §13: the other actions, reachable through Find Action and Window > Editor Tabs > Tab Groups. No default shortcuts. -->
        <action id="BetterEditorTabs.RenameCurrentGroup"
                class="dev.willcodes.bettereditortabs.tabgroups.actions.RenameCurrentGroupAction"/>
        <action id="BetterEditorTabs.ToggleCollapseCurrentGroup"
                class="dev.willcodes.bettereditortabs.tabgroups.actions.ToggleCollapseCurrentGroupAction"/>
        <action id="BetterEditorTabs.CollapseOtherGroups"
                class="dev.willcodes.bettereditortabs.tabgroups.actions.CollapseOtherGroupsAction"/>
        <action id="BetterEditorTabs.ExpandAllGroups"
                class="dev.willcodes.bettereditortabs.tabgroups.actions.ExpandAllGroupsAction"/>
        <action id="BetterEditorTabs.MoveTabToNextGroup"
                class="dev.willcodes.bettereditortabs.tabgroups.actions.MoveTabToNextGroupAction"/>
        <action id="BetterEditorTabs.MoveTabToPreviousGroup"
                class="dev.willcodes.bettereditortabs.tabgroups.actions.MoveTabToPreviousGroupAction"/>
        <action id="BetterEditorTabs.SelectNextTabInGroup"
                class="dev.willcodes.bettereditortabs.tabgroups.actions.SelectNextTabInGroupAction"/>
        <action id="BetterEditorTabs.SelectPreviousTabInGroup"
                class="dev.willcodes.bettereditortabs.tabgroups.actions.SelectPreviousTabInGroupAction"/>
        <action id="BetterEditorTabs.UngroupCurrentGroup"
                class="dev.willcodes.bettereditortabs.tabgroups.actions.UngroupCurrentGroupAction"/>
        <action id="BetterEditorTabs.StashCurrentGroup"
                class="dev.willcodes.bettereditortabs.tabgroups.actions.StashCurrentGroupAction"/>
        <action id="BetterEditorTabs.DeleteCurrentGroup"
                class="dev.willcodes.bettereditortabs.tabgroups.actions.DeleteCurrentGroupAction"/>

        <!-- §13: Window > Editor Tabs > Tab Groups. "EditorTabsGroup" is the Editor Tabs submenu of the Window menu (PlatformActions.xml:
             WindowMenu > EditorTabsGroup); the block goes last, after a separator of its own. The submenu itself is not searchable in
             Find Action (its actions are); the nested Add Tab to Group group stays searchable. -->
        <group id="BetterEditorTabs.WindowMenuBlock">
            <separator/>
            <group id="BetterEditorTabs.WindowMenu" popup="true" searchable="false">
                <reference ref="BetterEditorTabs.NewEmptyGroup"/>
                <reference ref="BetterEditorTabs.AddTabToNewGroup"/>
                <reference ref="BetterEditorTabs.AddTabToGroup"/>
                <reference ref="BetterEditorTabs.RemoveTabFromGroup"/>
                <separator/>
                <reference ref="BetterEditorTabs.RenameCurrentGroup"/>
                <reference ref="BetterEditorTabs.ToggleCollapseCurrentGroup"/>
                <reference ref="BetterEditorTabs.CollapseOtherGroups"/>
                <reference ref="BetterEditorTabs.ExpandAllGroups"/>
                <separator/>
                <reference ref="BetterEditorTabs.MoveTabToNextGroup"/>
                <reference ref="BetterEditorTabs.MoveTabToPreviousGroup"/>
                <reference ref="BetterEditorTabs.SelectNextTabInGroup"/>
                <reference ref="BetterEditorTabs.SelectPreviousTabInGroup"/>
                <separator/>
                <reference ref="BetterEditorTabs.UngroupCurrentGroup"/>
                <reference ref="BetterEditorTabs.StashCurrentGroup"/>
                <reference ref="BetterEditorTabs.DeleteCurrentGroup"/>
                <separator/>
                <reference ref="BetterEditorTabs.RestoreTabGroup"/>
            </group>
            <add-to-group group-id="EditorTabsGroup" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
